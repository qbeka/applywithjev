{
  "name": "applywithjev",
  "version": "0.1.0",
  "private": true,
  "description": "Finds software internships and new-grad roles, rates them with JEV, and applies through Claude Code and Claude in Chrome.",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "applywithjev": "./src/cli.ts" },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "discover": "tsx src/cli.ts discover",
    "status": "tsx src/cli.ts status",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
