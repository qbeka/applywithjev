# OpenRouter key with access to typesafe/jev-1.13. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Lets the tool read replies to your applications and record them.
# The tool only reads mail. Use a Google app password, never your account
# password: https://myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional. Shown on openrouter.ai rankings. Leave blank if you do not care.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=applywithjev
